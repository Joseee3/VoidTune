<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:background="#121212"

    android:layout_height="match_parent">

    <!-- Contenido principal -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Todo el contenido existente aquí -->

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@android:color/black"
            android:orientation="horizontal"
            android:paddingTop="35dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/userImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop"
                android:contentDescription="User Image" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tu biblioteca"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:gravity="center"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/add_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_plus"
                app:tint="@android:color/white"
                android:contentDescription="Agregar"
                android:layout_marginStart="8dp" />

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_search"
                app:tint="@android:color/white"
                android:contentDescription="Buscar"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Contenido principal -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_navigation_bar"
            android:layout_above="@id/bottomNavigationView"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Contenido existente -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Botón tipo chip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Playlists"
                        android:padding="8dp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/chip_background"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Lista de items -->
                    <Button
                        android:id="@+id/likeSongButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tus me gusta"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:background="@drawable/border_button"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="?selectableItemBackground"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_music_note"
                            android:tint="@android:color/white"
                            android:contentDescription="Icono" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Organic House"
                            android:textColor="@android:color/white"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Botones de agregar -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+ Agregar artistas"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/border_button"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/add_playlists_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+ Agregar playlists"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@drawable/border_button" />
                </LinearLayout>

                <!-- RecyclerView agregado -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/albumsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#121212"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/colorPrimary"
            app:itemTextColor="@color/colorPrimary"
            app:itemRippleColor="@color/colorAccent" />
    </RelativeLayout>

    <!-- Menú lateral -->
<com.google.android.material.navigation.NavigationView
    android:id="@+id/navigation_view"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    app:menu="@menu/drawer_menu"
    android:background="#1C1C1E"
    app:itemTextAppearance="@style/MenuTextStyle"
    app:itemIconTint="@android:color/white"
    app:itemTextColor="@color/colorPrimary"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.drawerlayout.widget.DrawerLayout>